<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 (JavaScript y WebAssembly del dictado) compila código en tiempo de ejecución. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Los que Electron pone por defecto. Quitarlos solo tras probar la app firmada con Developer ID
       (terminales, dictado y capturas): con firma ad hoc hace falta disable-library-validation. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Dictado: con Hardened Runtime, sin esto el micrófono falla en silencio. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
